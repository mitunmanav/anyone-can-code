{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$r=$env:PLUGIN_ROOT; if (-not $r) { $r=$env:CLAUDE_PLUGIN_ROOT }; if (-not $r) { $r=Join-Path (git rev-parse --show-toplevel) 'plugins\\anyone-can-code' }; python (Join-Path $r 'hooks\\scripts\\load_session.py')",
            "statusMessage": "ACC loading context..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$r=$env:PLUGIN_ROOT; if (-not $r) { $r=$env:CLAUDE_PLUGIN_ROOT }; if (-not $r) { $r=Join-Path (git rev-parse --show-toplevel) 'plugins\\anyone-can-code' }; python (Join-Path $r 'hooks\\scripts\\guard.py')",
            "statusMessage": "ACC checking request..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$r=$env:PLUGIN_ROOT; if (-not $r) { $r=$env:CLAUDE_PLUGIN_ROOT }; if (-not $r) { $r=Join-Path (git rev-parse --show-toplevel) 'plugins\\anyone-can-code' }; python (Join-Path $r 'hooks\\scripts\\guard.py')",
            "statusMessage": "ACC checking action..."
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$r=$env:PLUGIN_ROOT; if (-not $r) { $r=$env:CLAUDE_PLUGIN_ROOT }; if (-not $r) { $r=Join-Path (git rev-parse --show-toplevel) 'plugins\\anyone-can-code' }; python (Join-Path $r 'hooks\\scripts\\audit.py')",
            "statusMessage": "ACC checking permission..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$r=$env:PLUGIN_ROOT; if (-not $r) { $r=$env:CLAUDE_PLUGIN_ROOT }; if (-not $r) { $r=Join-Path (git rev-parse --show-toplevel) 'plugins\\anyone-can-code' }; python (Join-Path $r 'hooks\\scripts\\audit.py')",
            "statusMessage": "ACC recording signals..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$r=$env:PLUGIN_ROOT; if (-not $r) { $r=$env:CLAUDE_PLUGIN_ROOT }; if (-not $r) { $r=Join-Path (git rev-parse --show-toplevel) 'plugins\\anyone-can-code' }; python (Join-Path $r 'hooks\\scripts\\save_session.py')",
            "timeout": 30,
            "statusMessage": "ACC saving state..."
          }
        ]
      }
    ]
  }
}
