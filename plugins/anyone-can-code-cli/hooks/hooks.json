{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scripts/load_session.py\"",
            "statusMessage": "ACC loading context...",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\scripts\\load_session.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scripts/guard.py\"",
            "statusMessage": "ACC checking request...",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\scripts\\guard.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scripts/guard.py\"",
            "statusMessage": "ACC checking action...",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\scripts\\guard.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scripts/audit.py\"",
            "statusMessage": "ACC checking permission...",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\scripts\\audit.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scripts/audit.py\"",
            "statusMessage": "ACC recording signals...",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\scripts\\audit.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scripts/save_session.py\"",
            "timeout": 30,
            "statusMessage": "ACC saving state...",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\scripts\\save_session.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scripts/compact.py\"",
            "statusMessage": "ACC saving capsule before compaction...",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\scripts\\compact.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scripts/subagent.py\"",
            "statusMessage": "ACC briefing subagent...",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\scripts\\subagent.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scripts/subagent.py\"",
            "statusMessage": "ACC logging subagent result...",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\scripts\\subagent.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/scripts/compact.py\"",
            "statusMessage": "ACC re-injecting after compaction...",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\scripts\\compact.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
